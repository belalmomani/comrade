<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The floating companion characters drawn above other apps (the core feature of the app) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Only for the optional rewarded ad (AdMob, child-directed) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Apps for children must not use the advertising id -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
        <!-- Child-directed treatment and the G rating are set in code (AdMobProvider) before any ad is requested -->
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION"
            android:value="true" />
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING"
            android:value="true" />

        <!-- The child's home screen is what opens first; the grown-ups' screen is behind its "للأهل" button -->
        <activity
            android:name=".ChildHomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".VillageActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".PlaygroundActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".HouseActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ParentActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".GoalsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".AlbumActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".MiniGamesActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".MiniGameActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <service
            android:name=".ScreenLockService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Parent-chosen play time: keeps the phone on the games until the time ends or a parent ends it" />
        </service>

        <service
            android:name=".GhostOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating companion characters shown above other apps at the parent's request" />
        </service>
    </application>
</manifest>
