<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Only for checking and downloading app updates -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- The child's home screen is what opens first; the grown-ups' screen is behind its "للأهل" button -->
        <activity
            android:name=".ChildHomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".VillageActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".PlaygroundActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".HouseActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ParentActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".GoalsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".AlbumActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".MiniGamesActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".MiniGameActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />

        <service
            android:name=".ScreenLockService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Parent-chosen play time: keeps the phone on the games until the time ends or a parent ends it" />
        </service>

        <service
            android:name=".GhostOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating companion characters shown above other apps at the parent's request" />
        </service>
    </application>
</manifest>
